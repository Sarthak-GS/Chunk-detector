# Copy this file to .env and fill in your values
# DO NOT commit .env to git

# Google Gemini API key — get one free at https://ai.google.dev
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for LLM analysis
GEMINI_MODEL=models/gemini-2.5-flash

# Gemini embedding model (used when EMBED_BACKEND=gemini)
GEMINI_EMBED_MODEL=models/text-embedding-004

# LLM tuning
LLM_TEMPERATURE=0.35
LLM_MAX_TOKENS=3000
LLM_TIMEOUT_S=30
LLM_DISABLE=0

# Embedding backend: "ollama" (local) or "gemini" (cloud)
EMBED_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Database (SQLite default; swap to postgres:// for production)
DATABASE_URL=sqlite:///./churn_agent.db

# ML model directory
ML_DIR=ml
CHURN_THRESHOLD=0.50

# Server
FRONTEND_DIR=frontend
CORS_ORIGINS=*
SECRET_KEY=change-this-to-a-random-secret-string

# Auth: set to 0 to enable login screen
AUTH_DISABLED=1
APP_USERNAME=admin
APP_PASSWORD=change-me
